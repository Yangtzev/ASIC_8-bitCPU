; Window Layout <x> <y> <width> <height> <signalwidth> <valuewidth>
viewPort 0 25 1920 874 100 65

; File list:
; openDirFile [-d delimiter] [-s time_offset] [-rf auto_bus_rule_file] path_name file_name
openDirFile -d / "" "/home/user123/Desktop/ASIC/icc/output/control.fsdb"

; file time scale:
; fileTimeScale ### s|ms|us|ns|ps

; signal spacing:
signalSpacing 5

; windowTimeUnit is used for zoom, cursor & marker
; waveform viewport range
zoom 0.000000 1046360.000000
cursor 123000.000000
marker 0.000000

; user define markers
; userMarker time_pos marker_name color linestyle
; visible top row signal index
top 0
; marker line index
markerPos 16

; event list
; addEvent event_name event_expression
; curEvent event_name



COMPLEX_EVENT_BEGIN


COMPLEX_EVENT_END



; toolbar current search type
; curSTATUS search_type
curSTATUS ByChange


addGroup "G1"
activeDirFile "" "/home/user123/Desktop/ASIC/icc/output/control.fsdb"
addSignal -h 15 -UNSIGNED -HEX /control_test/opcode[2:0]
addSignal -h 15 -holdScope clk
addSignal -h 15 -holdScope rst_
addSignal -h 15 -holdScope zero
addSignal -h 15 -UNSIGNED -UDEC -holdScope i[31:0]
addSignal -h 15 -UNSIGNED -UDEC -holdScope j[31:0]
addSignal -h 15 -UNSIGNED -HEX -holdScope mnemonic[24:1]
addSignal -h 15 -holdScope rd
addSignal -h 15 -holdScope wr
addSignal -h 15 -holdScope ld_ir
addSignal -h 15 -holdScope ld_ac
addSignal -h 15 -holdScope ld_pc
addSignal -h 15 -holdScope inc_pc
addSignal -h 15 -holdScope halt
addSignal -h 15 -holdScope data_e
addSignal -h 15 -holdScope sel
